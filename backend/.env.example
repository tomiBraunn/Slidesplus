# Backend environment variables — copy to .env and fill in.
# These are SERVER-SIDE secrets. Never commit the real .env.

# Database
DATABASE_URL=
PORT=8000

# Auth / sessions
JWT_SECRET=
SESSION_SECRET=

# AI providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Unsplash
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# App
FRONTEND_URL=
